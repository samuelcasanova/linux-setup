      "Bash(grep *)",
      "Bash(rtk grep *)",
      "Bash(rtk proxy grep *)",
      "Bash(sudo grep *)",
      "Bash(sudo rtk grep *)",
      "Bash(ls *)",
      "Bash(rtk ls *)",
      "Bash(rtk proxy ls *)",
      "Bash(sudo ls *)",
      "Bash(sudo rtk ls *)",
      "Bash(read *)",
      "Bash(rtk read *)",
      "Bash(rtk proxy read *)",
      "Bash(sudo read *)",
      "Bash(sudo rtk read *)",
      "Bash(wc *)",
      "Bash(rtk wc *)",
