#!/bin/bash
# Deployed by roles/home_wireguard — DO NOT EDIT ON THE SERVER, edit the .j2 template instead.
#
# Location model: 2 states only. Corporate OpenVPN (wifec) is intentionally NEVER toggled by
# this script — it stays always-on via its own systemd unit (roles/wifec_vpn, wifecvpn.service),
# home or away, full stop. An earlier version of this script also stopped it while on office
# WiFi (on the theory that office WiFi already provides full corporate access, making the
# tunnel redundant there) — that assumption was wrong and has been removed; don't reintroduce
# office-WiFi detection to "fix" its absence here without a fresh, explicit reason to.
#   Home (Wired connection 1 active): WireGuard down (redundant, already on the LAN).
#   Away (anywhere else):             WireGuard up (needed to reach home).
#
# Safety mechanisms below exist because of a real incident: an earlier version of this script
# unconditionally re-issued `nmcli` commands on every invocation with no state check and no rate
# limit. Since bringing a VPN up/down is itself an interface state change, that created a genuine
# feedback loop — roughly one invocation every 20ms, causing a real connect/disconnect storm the
# user had to manually stop. Three independent safeguards now, so no single one failing can cause
# a repeat:
#   1. A non-blocking lock — if a previous invocation is still running, skip immediately rather
#      than queue or run concurrently.
#   2. A hard minimum interval between real runs, checked and enforced before anything else —
#      a backstop regardless of whether the state-checking logic below has a bug.
#   3. State-checking before every action — only call nmcli when the current state actually
#      differs from the target, instead of unconditionally re-applying it.

action="${2:-}"
case "$action" in
  up|down|vpn-up|vpn-down) ;;
  *) exit 0 ;;
esac

LOCK_FILE="/run/vpn-location-toggle.lock"
STATE_FILE="/run/vpn-location-toggle.last-run"
MIN_INTERVAL_SECS=5

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

now=$(date +%s)
last=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
if [ $(( now - last )) -lt "$MIN_INTERVAL_SECS" ]; then
  exit 0
fi
echo "$now" > "$STATE_FILE"

HOME_WIRED_CONN="{{ wifec_vpn_lan_connection }}"
WG_CONN="{{ home_wireguard_conn_name }}"

is_connection_active() {
  [ "$(nmcli -t -g GENERAL.STATE connection show "$1" 2>/dev/null)" = "activated" ]
}

home_wired_active=false
is_connection_active "$HOME_WIRED_CONN" && home_wired_active=true

logger -t vpn-location-toggle "home_wired=$home_wired_active"

wg_active=false
is_connection_active "$WG_CONN" && wg_active=true

if $home_wired_active; then
  if $wg_active; then
    logger -t vpn-location-toggle "action: bringing WireGuard down"
    nmcli connection down "$WG_CONN" >/dev/null 2>&1 || true
  fi
else
  if ! $wg_active; then
    logger -t vpn-location-toggle "action: bringing WireGuard up"
    nmcli connection up "$WG_CONN" >/dev/null 2>&1 || true
  fi
fi

exit 0
